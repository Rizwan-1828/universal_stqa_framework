# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual Environments
venv/
env/
ENV/

# Pytest / Test output
.pytest_cache/
.coverage
htmlcov/
pytest_output.txt
pytest_results.txt
parsed_results.txt
error_log*.txt

# Allure & Test Reports / Logs
reports/allure-results/*
!reports/allure-results/.gitkeep
reports/allure-report/
reports/logs/*
!reports/logs/.gitkeep
*.log

# Screenshots
screenshots/*.png
!screenshots/.gitkeep

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
